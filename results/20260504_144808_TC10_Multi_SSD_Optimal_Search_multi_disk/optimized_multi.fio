
[global]
ioengine=libaio
direct=1
rw=randread
bs=4k
iodepth=32
runtime=5
time_based=1
group_reporting=1
size=100%

[disk_0]
filename=/dev/ram0
numjobs=5
cpus_allowed=0-4

[disk_1]
filename=/dev/ram1
numjobs=5
cpus_allowed=5-9

[disk_2]
filename=/dev/ram2
numjobs=5
cpus_allowed=10-14

[disk_3]
filename=/dev/ram3
numjobs=5
cpus_allowed=15-19
